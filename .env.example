# Almarah Foundation V3 — copy privately to .env or use your host's secret manager.
# Blank values require an operator-supplied value; DO NOT commit filled-in files.
# APP_NAME controls visible branding; release version/name are fixed in config/app.php.
APP_NAME=Almarah Foundation
APP_ENV=production
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=Asia/Karachi
APP_CURRENCY=PKR
APP_KEY=
PUBLIC_PATH=
SETUP_LOCK=
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax
SESSION_LIFETIME=120
SESSION_NAME=almarah_session

# Separate application MySQL database; never point tests at production.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SMTP. Leave password blank until securely supplied; verify outgoing mail.
MAIL_MAILER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Almarah Foundation
MAIL_REPLY_TO=
MAIL_VERIFY_PEER=true
MAIL_QUEUE_ENABLED=true
MAIL_MAX_RETRIES=3
MAIL_BATCH_SIZE=25
MAIL_DEBUG=false

# Optional, SELECT-only bridge to a separate fundraising installation.
FUNDRAISE_URL=
FUNDRAISE_DB_HOST=
FUNDRAISE_DB_DATABASE=
FUNDRAISE_DB_USERNAME=
FUNDRAISE_DB_PASSWORD=

# Keep encrypted backups outside the document root; secure the passphrase separately.
BACKUP_PATH=
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=30
BACKUP_OFFSITE_CMD=

# Online gateways MUST remain disabled until approved merchant sandbox testing.
# UBL is named etisalat in the pre-existing gateway implementation.
MEEZAN_ENABLED=false
MEEZAN_ENVIRONMENT=sandbox
MEEZAN_API_URL=
MEEZAN_SANDBOX_URL=
MEEZAN_LIVE_URL=
MEEZAN_RETURN_URL=
MEEZAN_USERNAME=
MEEZAN_PASSWORD=
MEEZAN_MERCHANT_ID=
MEEZAN_CURRENCY_CODE=586
MEEZAN_CURRENCY_NAME=PKR
MEEZAN_TIMEOUT=30
MEEZAN_ALLOWED_HOSTS=
ETISALAT_ENABLED=false
ETISALAT_ENVIRONMENT=sandbox
ETISALAT_SANDBOX_URL=
ETISALAT_LIVE_URL=
ETISALAT_PORT=2443
ETISALAT_CUSTOMER=
ETISALAT_USERNAME=
ETISALAT_PASSWORD=
ETISALAT_STORE=
ETISALAT_TERMINAL=
ETISALAT_CURRENCY=PKR
ETISALAT_TRANSACTION_HINT=
ETISALAT_ACCEPT_HEADER=
ETISALAT_TIMEOUT=30
ETISALAT_ALLOWED_HOSTS=
CALLBACK_STATE_TTL_MINUTES=180
PAYMENT_LOCK_TIMEOUT_SECONDS=45
# Stripe: no STRIPE_* variables are consumed by this release. Do not enable it.

# Public Geo-IP: https://ipwho.is/ (visitor IP sent server-side; disclose in privacy notice).
# Public FX estimates: https://open.er-api.com/v6/latest/PKR (never settlement rates).
DONATION_GEO_DISABLE_REMOTE=0
DONATION_RATES_DISABLE_REMOTE=0
DONATION_RATES_CACHE_FILE=

# Optional application limits, maintenance and queue policy.
MAINTENANCE_MODE=false
MAINTENANCE_ALLOW_IPS=
DONATION_MIN_MINOR=10000
DONATION_MAX_MINOR=500000000
DONATION_MAX_ATTEMPTS=5
DONATION_DECAY_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=15
LOGIN_DECAY_MINUTES=15
TEAM_FUNDRAISING_ENABLED=true
FUNDRAISER_AUTO_APPROVE=false
UPLOAD_DIRECTORY=
UPLOAD_MAX_BYTES=
UPLOAD_ALLOWED_MIME=
UPLOAD_ALLOWED_EXT=
UPLOAD_IMAGE_WIDTH=
